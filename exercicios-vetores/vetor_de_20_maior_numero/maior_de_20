#include <stdio.h>
int main(){
	int v[20],i,menor = 0, posicao=0;
	
	for(i=0;i<20;i++){
		printf("insira o numero: ");
		scanf("%d", &v[i]);
	}
	menor = v[0]; 
    posicao = 0;
	for(i=0;i<20;i++){
		if(v[i] < menor){
			menor = v[i];
			posicao= i;
		}
	}
	printf("menor elemento: %d ", menor);
	printf("sua posicao: %d ", posicao);
return 0;
}


